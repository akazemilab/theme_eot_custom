#!/usr/bin/env bash
# eot - token-cheap toolkit for the eot.ir Odoo site (website 1 on
# eot-odoo-prod, 95.38.235.225, db eot_main). Runs on the VPS; talks to prod
# over the dedicated SSH key (alias "eot-odoo-prod" in /root/.ssh/config).
#
# Designed so Claude gets a short verdict instead of raw output.
# Run "eot help" for the command list.
set -uo pipefail
TOOLS=/root/eot-tools                      # venv lives here
SRC=$(dirname "$(readlink -f "$0")")       # scripts: git clone of the theme repo (tools/vps)
PY="$TOOLS/venv/bin/python $SRC/eotcheck.py"
PROD=eot-odoo-prod
REPO=/opt/odoo/themes/theme_eot_custom

prod() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$PROD" "$@"; }
sql() { prod "sudo -u postgres psql -d eot_main -At -F ' | ' -v ON_ERROR_STOP=1" ; }

case "${1:-help}" in
  check)        shift; $PY check "$@" ;;
  placeholders) shift; $PY placeholders "$@" ;;
  text)         shift; $PY text "$@" ;;
  links)        shift; $PY links "$@" ;;
  verify)       # everything to run after a deploy, one call
    shift; $PY check "$@" | tail -4; $PY links "$@"; $PY placeholders ;;

  sql)          # eot sql "select ..."   (query also accepted on stdin)
    shift; if [ $# -gt 0 ]; then printf '%s\n' "$*" | sql; else sql; fi ;;

  find)         # eot find "text"  -> active views (website 1 or generic) containing text
    shift; q=${1//\'/\'\'}
    printf "select id, key, coalesce(website_id::text,'generic'), inherit_id from ir_ui_view where active and (website_id=1 or website_id is null) and arch_db::text ilike '%%%s%%' order by website_id nulls last, id;\n" "$q" | sql ;;

  view)         # eot view ID [lang]  -> arch of a view (en_US by default)
    shift; printf "select arch_db->>'%s' from ir_ui_view where id=%d;\n" "${2:-en_US}" "$1" | sql ;;

  deploy)       # eot deploy REF  -> deploy + compact verdict; on failure the real error
    shift; ref=${1:?usage: eot deploy <branch|commit>}
    out=$(prod "$REPO/scripts/deploy.sh '$ref'" 2>&1); rc=$?
    echo "$out" | grep -E '^(Checked out|OK:|!!)' | sed 's/^/  /'
    if [ $rc -ne 0 ]; then
      echo "  --- error detail (latest upgrade log) ---"
      prod "f=\$(ls -t /var/log/odoo/deploy-theme_eot_custom-*.log | head -1); grep -E 'ParseError|Error:|Exception|while parsing|For external id|xpath|Element' \"\$f\" | grep -v 'markdown2' | tail -8"
    fi
    exit $rc ;;

  log)          # eot log [since] [pattern] -> grouped error types + failing requests, with counts
    shift; since=${1:--30min}; pat=${2:-}
    if [ -n "$pat" ]; then prod "journalctl -u odoo20 --since '$since' --no-pager -o cat | grep -E '$pat' | tail -20"; exit; fi
    prod "journalctl -u odoo20 --since '$since' --no-pager -o cat > /tmp/eotlog.txt
      echo '-- error types --'; grep -E '^[A-Za-z_.]+(Error|Exception)[:]' /tmp/eotlog.txt | cut -c1-160 | sort | uniq -c | sort -rn | head -8
      echo '-- failing requests (4xx/5xx) --'; grep -oE '\"(GET|POST) [^ ]+ HTTP/[0-9.]+\" [45][0-9]{2}' /tmp/eotlog.txt | python3 -c 'import sys,urllib.parse as u; [print(u.unquote(l.strip())) for l in sys.stdin]' | sort | uniq -c | sort -rn | head -15" ;;

  status)       # service + deployed commit + website answering
    prod "systemctl is-active odoo20; cd $REPO && git log --oneline -1; for h in www.eot.ir; do printf '%s ' \$h; curl -s -o /dev/null -w '%{http_code}\n' -H \"Host: \$h\" http://127.0.0.1:8069/; done" ;;

  rehearse-stop) # eot rehearse-stop DB  -> stop+drop a rehearsal clone, verified
    shift; db=${1:?usage: eot rehearse-stop <db>}
    case "$db" in eot_main|eot_main_*) echo "!! refusing: '$db' looks like the live db, not a rehearsal clone"; exit 1 ;; esac
    prod "pkill -f '[-]d $db' 2>/dev/null; sleep 1; \
      sudo -u postgres dropdb --if-exists --force '$db'; \
      rm -rf /opt/odoo/.local/share/Odoo/filestore/'$db'; \
      echo pg:\$(sudo -u postgres psql -Atc \"select 1 from pg_database where datname='$db'\"); \
      echo fs:\$(test -d /opt/odoo/.local/share/Odoo/filestore/'$db' && echo present || echo gone); \
      echo proc:\$(pgrep -af \"[-]d $db\" | wc -l)" ;;

  ssh)          shift; prod "$@" ;;

  update)       # pull the latest toolkit from GitHub (source of truth: theme repo tools/vps)
    git -C "$SRC/../.." fetch -q origin main && git -C "$SRC/../.." checkout -q -B main origin/main && git -C "$SRC/../.." log --oneline -1 ;;

  help|*)
    cat <<'EOF'
eot check [URL]          page + assets: status/type, CSS actually parses (rule count)
eot placeholders [BASE]  crawl sitemap, find demo placeholders on rendered pages
eot links [URL]          internal links on a page that don't return 200
eot verify [URL]         post-deploy bundle: check + links + placeholders
eot text URL [N]         visible text of a page
eot find "text"          which active views (website 1 / generic) contain text
eot view ID [lang]       arch of a view
eot sql "query"          psql on eot_main (compact)
eot deploy REF           deploy theme ref; on failure prints the real error
eot rehearse-stop DB     stop+drop a rehearsal DB clone, with proof (pg/fs/proc), refuses eot_main*
eot log [since] [pattern]  grouped error types + failing URLs (default last 30 min)
eot status               service, deployed commit, both websites HTTP
eot ssh CMD              run a command on eot-odoo-prod
eot update               git pull the toolkit (edit it in the theme repo, not on the VPS)
EOF
    ;;
esac
