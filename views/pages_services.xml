<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Milestone 6, group 1: services & offerings ("product" look).
        Approved mockups: canvas "eot.ir — Inner pages redesign", page 1.

        Each template replaces the #wrap of an existing website-1 builder
        page (named by migrations/20.0.6.0.0/pre-migrate.py). Copy is the
        page's own text from eot_main. Styles: static/src/scss/pages.scss.
    -->

    <!-- ================================================================
         /خدمات - services hub
         ================================================================ -->
    <template id="page_services" name="EOT page: services hub" inherit_id="theme_eot_custom.eot_pv_services">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure eot-pg eot-pg-svc">
                <section class="eot-hero eot-hero-overlap">
                    <div class="container">
                        <div class="eot-hero-in">
                            <span class="eot-kicker">نقشه خدمات هیجان اندیشه</span>
                            <h1>از شناخت تا یادگیری و همراهی تخصصی</h1>
                            <p class="eot-hero-lead">همه خدمات هیجان اندیشه در یک مسیر روشن؛ از ارزیابی و خودشناسی تا یادگیری، کلاس گروهی، مشاوره و رشد حرفه‌ای روان‌شناسی.</p>
                            <div class="eot-row-btns">
                                <a href="#service-map" class="eot-btn eot-btn-sand">مشاهده همه خدمات</a>
                                <a href="#choose-by-need" class="eot-btn eot-btn-ghost">بر اساس نیاز انتخاب کنم</a>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="choose-by-need" class="container eot-overlap">
                    <div class="eot-card">
                        <div class="eot-sec-head">
                            <h2 class="eot-h3">از کجا شروع کنم؟</h2>
                            <p class="eot-lead">به‌جای شناخت نام خدمات، از نیاز خودتان شروع کنید.</p>
                        </div>
                        <div class="eot-grid eot-grid-4">
                            <a href="/مشاوره-روانشناسی-آنلاین" class="eot-need">
                                <span class="eot-icon-box"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg></span>
                                <strong>گفت‌وگو با متخصص</strong>
                                <span>مسئله‌ای دارم که می‌خواهم با روان‌شناس یا مشاور بررسی کنم.</span>
                                <em>مشاوره روان‌شناسی ←</em>
                            </a>
                            <a href="/آزمون-روانشناسی" class="eot-need">
                                <span class="eot-icon-box"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/></svg></span>
                                <strong>شناخت بهتر خودم</strong>
                                <span>می‌خواهم یک موضوع، توانایی یا الگوی روان‌شناختی را بهتر بشناسم.</span>
                                <em>ارزیابی‌ها ←</em>
                            </a>
                            <a href="/یادگیری-خودیار-روانشناسی" class="eot-need">
                                <span class="eot-icon-box"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5z"/><path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5z"/></svg></span>
                                <strong>یادگیری و تمرین</strong>
                                <span>می‌خواهم موضوعی را مرحله‌به‌مرحله یاد بگیرم و تمرین کنم.</span>
                                <em>مرکز یادگیری ←</em>
                            </a>
                            <a href="/کارورزی-روانشناسی-آنلاین" class="eot-need">
                                <span class="eot-icon-box"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20l6-6 4 4 8-8"/><path d="M15 10h6v6"/></svg></span>
                                <strong>رشد حرفه‌ای</strong>
                                <span>دانشجو یا فعال روان‌شناسی هستم و مسیر تخصصی می‌خواهم.</span>
                                <em>کارورزی حرفه‌ای ←</em>
                            </a>
                        </div>
                    </div>
                </section>

                <section id="service-map" class="container eot-sec">
                    <div class="eot-sec-head">
                        <span class="eot-kicker">کاتالوگ خدمات</span>
                        <h2 class="eot-h2">همه خدمات و برنامه‌ها</h2>
                        <p class="eot-lead">هر خدمت صفحه اختصاصی خود را دارد و از اینجا می‌توانید مستقیماً وارد مسیر مناسب شوید.</p>
                    </div>
                    <div class="eot-grid eot-grid-2">
                        <a href="/مشاوره-روانشناسی-آنلاین" class="eot-card-dark eot-svc-feature">
                            <span class="eot-pill eot-pill-dark" style="align-self: flex-start;">افراد، زوج‌ها و خانواده‌ها</span>
                            <h3>مشاوره روان‌شناسی</h3>
                            <p>انتخاب روان‌شناس یا مشاور، مشاهده زمان‌های قابل رزرو و ورود به فرایند جلسه تخصصی.</p>
                            <span class="eot-svc-figs">
                                <span><b>۹</b><small>روان‌شناس و مشاور</small></span>
                                <span><b>آنلاین</b><small>بدون مراجعه حضوری</small></span>
                            </span>
                            <span class="eot-btn eot-btn-sand" style="align-self: flex-start; margin-top: auto;">انتخاب متخصص ←</span>
                        </a>
                        <a href="/آزمون-روانشناسی" class="eot-card eot-svc">
                            <span class="eot-svc-aud">افرادی که می‌خواهند شناخت دقیق‌تری از خود داشته باشند</span>
                            <h3>ارزیابی‌های روان‌شناختی</h3>
                            <p>ارزیابی‌های ساختاریافته در موضوعاتی مانند شخصیت، آرامش، استعداد، شناخت، روابط و زندگی شغلی.</p>
                            <em>مشاهده ارزیابی‌ها ←</em>
                        </a>
                        <a href="/یادگیری-خودیار-روانشناسی" class="eot-card eot-svc">
                            <span class="eot-svc-aud">عموم، علاقه‌مندان و فراگیران</span>
                            <h3>یادگیری آنلاین روان‌شناسی</h3>
                            <p>مسیرهای eLearning برای یادگیری کوتاه، تمرین، بازیابی فعال و پیشرفت مرحله‌ای بر پایه موضوع یا نتیجه ارزیابی.</p>
                            <em>ورود به مرکز یادگیری ←</em>
                        </a>
                        <a href="/کلاس-گروهی-آنلاین" class="eot-card eot-svc">
                            <span class="eot-svc-aud">افرادی که یادگیری زنده و گروهی را ترجیح می‌دهند</span>
                            <h3>کلاس‌ها و کارگاه‌های گروهی</h3>
                            <p>جلسات هفتگی و دوره‌های چندجلسه‌ای گروهی برای گفت‌وگو، تمرین و یادگیری تعاملی.</p>
                            <em>مشاهده برنامه کلاس‌ها ←</em>
                        </a>
                        <a href="/کارورزی-روانشناسی-آنلاین" class="eot-card eot-svc">
                            <span class="eot-svc-aud">دانش‌آموختگان و فعالان روان‌شناسی و مشاوره</span>
                            <h3>کارورزی حرفه‌ای روان‌شناسی</h3>
                            <p>مسیر حرفه‌ای بلندمدت از تشخیص، راهنمایی و مشاوره، حمایت و درمان تا دستیاری و کمیسیون هفتگی.</p>
                            <em>مشاهده مسیر کارورزی ←</em>
                        </a>
                    </div>
                </section>

                <section class="container eot-sec">
                    <div class="eot-sec-head">
                        <span class="eot-kicker">ارتباط میان خدمات</span>
                        <h2 class="eot-h2">خدمات جدا از هم نیستند</h2>
                        <p class="eot-lead" style="max-width: 52rem;">بسته به نیاز شما، یک مسیر می‌تواند از ارزیابی شروع شود، با آموزش ادامه پیدا کند و در صورت نیاز به کلاس گروهی یا همراهی متخصص برسد.</p>
                    </div>
                    <ol class="eot-rail">
                        <li><b>۱</b><strong>شناخت</strong><span>ارزیابی و منابع علمی</span></li>
                        <li><b>۲</b><strong>یادگیری</strong><span>eLearning و مطالعه هدایت‌شده</span></li>
                        <li><b>۳</b><strong>تمرین گروهی</strong><span>کلاس و کارگاه زنده</span></li>
                        <li><b>۴</b><strong>همراهی تخصصی</strong><span>مشاوره روان‌شناسی</span></li>
                        <li><b>۵</b><strong>مسیر حرفه‌ای</strong><span>کارورزی و دستیاری</span></li>
                    </ol>
                </section>

                <section class="container eot-sec">
                    <div class="eot-sec-head">
                        <span class="eot-kicker">منابع مکمل</span>
                        <h2 class="eot-h2">دانش و منابع علمی</h2>
                        <p class="eot-lead">علاوه بر خدمات، هیجان اندیشه مجموعه‌ای از منابع ساختاریافته برای مطالعه، جست‌وجو و یادگیری عمیق‌تر ارائه می‌کند.</p>
                    </div>
                    <div class="eot-grid eot-grid-3">
                        <a href="/مقالات" class="eot-tile"><strong>مقالات</strong><span>برای مطالعه موضوعی و کاربردی.</span></a>
                        <a href="/کتب" class="eot-tile"><strong>کتاب‌ها</strong><span>برای مطالعه پیوسته و عمیق‌تر.</span></a>
                        <a href="/فرهنگنامه" class="eot-tile"><strong>فرهنگنامه</strong><span>برای تعریف و جست‌وجوی مفاهیم تخصصی.</span></a>
                    </div>
                </section>

                <section class="container eot-sec eot-sec-last">
                    <div class="eot-card eot-stack" style="padding: 2.25rem;">
                        <span class="eot-kicker">اگر هنوز مطمئن نیستید</span>
                        <h2 class="eot-h3" style="font-size: 1.75rem;">مسیر را بر اساس نیاز انتخاب کنید</h2>
                        <p class="eot-body" style="max-width: 56rem;">اگر مسئله شما نیازمند بررسی حرفه‌ای است، مشاوره مناسب‌تر است. اگر هدف شناخت یا یادگیری است، می‌توانید از ارزیابی‌ها، eLearning یا منابع علمی شروع کنید.</p>
                        <div class="eot-row-btns">
                            <a href="/مشاوره-روانشناسی-آنلاین" class="eot-btn eot-btn-teal">انتخاب مشاور</a>
                            <a href="/آزمون-روانشناسی" class="eot-btn eot-btn-line">شروع از ارزیابی</a>
                            <a href="/contactus" class="eot-btn eot-btn-text">تماس با هیجان اندیشه</a>
                        </div>
                        <p class="eot-note"><strong>توجه:</strong> محتوای آموزشی و نتایج خودسنجی به‌تنهایی جایگزین تشخیص یا درمان تخصصی نیستند. در صورت نیاز به بررسی حرفه‌ای، از خدمات روان‌شناسی و مشاوره استفاده کنید.</p>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <!-- ================================================================
         /مشاوره-روانشناسی-آنلاین - online counseling
         Booking itself happens on the live sepehrtherapy.ir system.
         ================================================================ -->
    <template id="page_counseling" name="EOT page: counseling" inherit_id="theme_eot_custom.eot_pv_counseling">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure eot-pg eot-pg-svc">
                <t t-set="therapists" t-value="[
                    ('م', 'محمد صادق علیخانی', 'روان‌شناس', 14),
                    ('ر', 'راضیه جهانشاهی', 'روان‌شناس', 12),
                    ('ز', 'زینت السادات میرطاهری', 'روان‌شناس', 11),
                    ('ط', 'طیبه مالمیر', 'روان‌شناس', 143),
                    ('م', 'مریم ملک', 'روان‌شناس', 13),
                    ('م', 'مهوش طالبی', 'روان‌شناس', 10),
                    ('ن', 'نجده مساعدیان', 'مشاور', 15),
                    ('م', 'محیا سامت', 'روان‌شناس', 173),
                 ]"/>
                <section class="eot-hero">
                    <div class="container eot-hero-split">
                        <div class="eot-hero-in">
                            <span class="eot-kicker">جلسه آنلاین • انتخاب درمانگر • رزرو زمان</span>
                            <h1>مشاوره روان‌شناسی آنلاین</h1>
                            <p class="eot-hero-lead">درمانگر خود را انتخاب کنید، زمان‌های خالی را ببینید و جلسه روان‌شناسی را به‌صورت آنلاین رزرو کنید.</p>
                            <p class="eot-hero-sub">جلسات برای بررسی، پیگیری و درمان مسائل روان‌شناختی در سامانه رزرو سپهر هیجان اندیش برگزار می‌شوند.</p>
                            <div class="eot-row-btns">
                                <a href="#therapists" class="eot-btn eot-btn-sand">انتخاب روان‌شناس یا مشاور</a>
                                <a href="https://www.sepehrtherapy.ir/appointment/4?skip_resource_selection=1" target="_blank" rel="noopener" class="eot-btn eot-btn-ghost">مشاهده اولین زمان‌های خالی
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
                            </div>
                        </div>
                        <div class="eot-stack">
                            <div class="eot-glass"><span class="eot-glass-big">۹</span><span><strong>روان‌شناس و مشاور</strong><small>انتخاب مستقیم درمانگر</small></span></div>
                            <div class="eot-glass"><span class="eot-glass-icon"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#E4D6A0" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="13" height="12" rx="2"/><path d="M16 10l5-3v10l-5-3"/></svg></span><span><strong>آنلاین</strong><small>برگزاری جلسه بدون نیاز به مراجعه حضوری</small></span></div>
                            <div class="eot-glass"><span class="eot-glass-icon"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#E4D6A0" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span><span><strong>رزرو زمان</strong><small>تقویم آنلاین؛ انتخاب روز و ساعت مناسب</small></span></div>
                        </div>
                    </div>
                </section>

                <section class="container eot-sec">
                    <div class="eot-sec-head"><h2 class="eot-h2">رزرو جلسه چگونه انجام می‌شود؟</h2></div>
                    <ol class="eot-steps eot-grid eot-grid-3">
                        <li class="eot-card eot-step"><span class="eot-num">۱</span><strong>درمانگر را انتخاب کنید</strong><span>از میان روان‌شناسان و مشاوران، فرد مورد نظر خود را انتخاب کنید.</span></li>
                        <li class="eot-card eot-step"><span class="eot-num">۲</span><strong>روز و ساعت را ببینید</strong><span>با ورود به تقویم رزرو، زمان‌های خالی درمانگر را مشاهده و زمان مناسب را انتخاب کنید.</span></li>
                        <li class="eot-card eot-step"><span class="eot-num">۳</span><strong>رزرو را تکمیل کنید</strong><span>اطلاعات لازم را ثبت و فرایند رزرو جلسه آنلاین را در سامانه سپهر هیجان اندیش تکمیل کنید.</span></li>
                    </ol>
                </section>

                <section id="therapists" class="container eot-sec">
                    <div class="eot-sec-head">
                        <h2 class="eot-h2">روان‌شناسان و مشاوران</h2>
                        <p class="eot-lead">با انتخاب هر درمانگر، مستقیماً وارد صفحه زمان‌های خالی همان فرد در سامانه رزرو می‌شوید.</p>
                    </div>
                    <article class="eot-card-gold eot-feature-person">
                        <img src="/web/image/836-bdfdb71c/h33-1.svg" alt="تصویر دکتر ناصرالدین کاظمی حقیقی" loading="lazy"/>
                        <div class="eot-stack">
                            <span class="eot-pill eot-pill-sand" style="align-self: flex-start;">جلسه اختصاصی</span>
                            <h3>دکتر ناصرالدین کاظمی حقیقی</h3>
                            <span class="eot-lead">مشاور • بنیان‌گذار هیجان اندیشه</span>
                            <dl class="eot-meta eot-meta-3">
                                <div><dt>نوع جلسه</dt><dd>آنلاین</dd></div>
                                <div><dt>مدت</dt><dd>۳۰ دقیقه</dd></div>
                                <div><dt>هزینه فعلی جلسه</dt><dd class="eot-num-font">۱٬۱۰۰٬۰۰۰ تومان</dd></div>
                            </dl>
                        </div>
                        <div class="eot-feature-cta"><a href="https://www.sepehrtherapy.ir/appointment/11" target="_blank" rel="noopener" class="eot-btn eot-btn-teal">زمان‌های خالی و رزرو</a></div>
                    </article>
                    <div class="eot-grid eot-grid-4" style="margin-top: 1rem;">
                        <article t-foreach="therapists" t-as="t" class="eot-card eot-person">
                            <div class="eot-person-head">
                                <span class="eot-mono" aria-hidden="true" t-out="t[0]"/>
                                <span><h3 t-out="t[1]"/><small t-out="t[2]"/></span>
                            </div>
                            <div class="eot-person-meta"><span>آنلاین • ۴۵ دقیقه</span><b>۸۸۰٬۰۰۰ تومان</b></div>
                            <a t-att-href="'https://www.sepehrtherapy.ir/appointment/4?staff_user_id=%s' % t[3]" target="_blank" rel="noopener" class="eot-btn eot-btn-line" t-att-aria-label="'زمان‌های خالی و رزرو - %s' % t[1]">زمان‌های خالی و رزرو</a>
                        </article>
                    </div>
                </section>

                <section class="container" style="padding-top: 2.5rem;">
                    <div class="eot-band">
                        <div>
                            <h2>اگر انتخاب درمانگر برایتان مهم نیست</h2>
                            <p>می‌توانید همه وقت‌های خالی موجود را ببینید و بر اساس نزدیک‌ترین زمان مناسب، جلسه خود را انتخاب کنید.</p>
                        </div>
                        <a href="https://www.sepehrtherapy.ir/appointment/4?skip_resource_selection=1" target="_blank" rel="noopener" class="eot-btn eot-btn-white">مشاهده کل وقت‌های خالی</a>
                    </div>
                </section>

                <section class="container eot-sec eot-sec-last">
                    <div class="eot-two">
                        <div class="eot-stack">
