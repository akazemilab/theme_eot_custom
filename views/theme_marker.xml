<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Scaffold marker. Adds one invisible <meta> tag to the page head so a
        deploy can be verified with curl: it must appear on website 1 and must
        NOT appear on website 3. No visual effect.
    -->
    <template id="theme_marker" name="EOT Theme: marker" inherit_id="website.layout">
        <xpath expr="//head/meta[last()]" position="after">
            <meta name="eot-theme" content="theme_eot_custom"/>
        </xpath>
    </template>

    <!--
        Persian webfonts. Loaded as <link> tags rather than an SCSS @import:
        see the note in static/src/scss/theme.scss for why an @import of a
        Google Fonts URL broke the whole frontend stylesheet (the URL's ";"
        gets treated as a rule separator by Odoo's bundler).

        Milestone 8 type system (approved "Direction D" fonts):
        Vazirmatn 400-700 for body copy and UI, Estedad 500-700 for
        headings and numbers (better-drawn Persian digits). Heavier weights
        are deliberately not loaded: the design tops out at 700.
    -->
    <template id="theme_font" name="EOT Theme: Persian fonts" inherit_id="website.layout">
        <xpath expr="//head/meta[last()]" position="after">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <!-- Not render-blocking (SEO milestone): from Iranian networks this
                 stylesheet took 0.3-0.6 s before anything could paint. Text
                 now renders at once in the fallback font and swaps to
                 Vazirmatn/Estedad when they arrive (display=swap, as before). -->
            <link rel="stylesheet" media="print" onload="this.media='all'"
                  href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&amp;family=Estedad:wght@500;600;700&amp;display=swap"/>
            <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&amp;family=Estedad:wght@500;600;700&amp;display=swap"/></noscript>
        </xpath>
    </template>
</odoo>
