<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Scaffold marker. Adds one invisible <meta> tag to the page head so a
        deploy can be verified with curl: it must appear on website 1 and must
        NOT appear on website 3. No visual effect.
    -->
    <template id="theme_marker" name="EOT Theme: marker" inherit_id="website.layout">
        <xpath expr="//head/meta[last()]" position="after">
            <meta name="eot-theme" content="theme_eot_custom"/>
        </xpath>
    </template>

    <!--
        Persian webfonts. Loaded as <link> tags rather than an SCSS @import:
        see the note in static/src/scss/theme.scss for why an @import of a
        Google Fonts URL broke the whole frontend stylesheet (the URL's ";"
        gets treated as a rule separator by Odoo's bundler).

        Vazirmatn: body copy (already in place, reads well at small sizes).
        Estedad: headings only - a richer, more distinctive display face
        with a full 100-900 weight range and better-drawn Persian digits,
        used to make headings/numbers feel more considered than plain
        Vazirmatn Bold. See static/src/scss/theme.scss for where each is
        applied.
    -->
    <template id="theme_font" name="EOT Theme: Persian fonts" inherit_id="website.layout">
        <xpath expr="//head/meta[last()]" position="after">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&amp;family=Estedad:wght@500;600;700;800;900&amp;display=swap"/>
        </xpath>
    </template>
</odoo>
