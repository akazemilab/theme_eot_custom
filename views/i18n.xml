<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Hardcoded English strings the fa_IR translation didn't catch.

        "Sign in" comes from portal.user_sign_in (addons/portal/views/
        portal_templates.xml) - a literal English string in the template,
        normally covered by Odoo's own fa_IR translation of the portal
        module. It was still showing in English, which points at the
        fa_IR language pack's module translations being stale/incomplete
        on this instance (see CLAUDE.md pitfall #6 - this DB was carried
        over from another instance). The real fix for that is reloading
        fa_IR translations for base/web/website/portal on the server
        (see README/ops notes); this template patch is a guaranteed,
        version-controlled backstop for this specific string regardless
        of that.
    -->
    <template id="user_sign_in_fa"
              name="EOT: 'Sign in' in Persian"
              inherit_id="portal.user_sign_in">
        <!--
            Odoo 20's actual portal.user_sign_in arch does NOT carry the
            "t-if=request.session.profile_session" debug-marker span some
            other Odoo versions' source has (confirmed: reproducing it here
            threw "'Session' object has no attribute 'profile_session'" -
            AttributeError on every page). Replace the <a> with just the
            translated text, nothing else.
        -->
        <xpath expr="//a[@t-attf-href='/web/login']" position="replace">
            <a t-attf-href="/web/login" t-attf-class="#{_link_class}">ورود</a>
        </xpath>
    </template>

    <!--
        Header search box (website.website_search_box): "Loading..." (a
        screen-reader-only spinner label) and " result(s)" (the visible
        count next to search results) are literal English with no fa.po
        entry upstream - reloading fa_IR translations (ops note below)
        didn't touch these because there is nothing to load; they were
        never translated in Odoo core to begin with.
    -->
    <template id="search_box_fa"
              name="EOT: search box spinner/result(s) in Persian"
              inherit_id="website.website_search_box">
        <xpath expr="//span[hasclass('visually-hidden')]" position="replace">
            <span class="visually-hidden">در حال بارگذاری...</span>
        </xpath>
        <xpath expr="//small[contains(@t-attf-class,'o_search_found_results')]" position="replace">
            <small t-attf-class="o_search_found_results {{'d-none' if not search else ''}}">
                <span class="o_search_count" t-out="search_count"/> نتیجه
            </small>
        </xpath>
    </template>

    <!--
        Default search-box placeholder ("Search..." when no other
        placeholder was passed in) - same story as above: a literal text
        node, not a translatable string, in website.website_search_box_input.
    -->
    <template id="search_box_placeholder_fa"
              name="EOT: search box default placeholder in Persian"
              inherit_id="website.website_search_box_input">
        <xpath expr="//t[@t-set='placeholder']" position="replace">
            <t t-if="not placeholder" t-set="placeholder">جستجو...</t>
        </xpath>
    </template>
    <!--
        Keyboard "skip to content" link (portal.frontend_layout) is literal
        English with no Persian translation on this instance; every page
        showed "Skip to Content" to keyboard and screen-reader users.
    -->
    <template id="skip_to_content_fa"
              name="EOT: 'Skip to Content' in Persian"
              inherit_id="portal.frontend_layout">
        <xpath expr="//a[hasclass('o_skip_to_content')]" position="replace">
            <a class="o_skip_to_content btn btn-primary rounded-0 visually-hidden-focusable position-absolute start-0" href="#wrap" groups="!base.group_user">پرش به محتوای اصلی</a>
        </xpath>
    </template>

    <!--
        Milestone 8: remaining English on the sign-in and search pages.
        All literal template text or Python strings with no fa.po entry
        upstream (checked in the Odoo 20 source on eot-odoo-prod).
        Appearance/wording only - no logic changes: the same /web/login
        route also serves staff sign-in.
    -->
    <template id="login_fa" name="EOT: sign-in form in Persian" inherit_id="web.login">
        <!-- Browser tab title: website.layout falls back to this view's name
             ("Login") when no additional_title is set. -->
        <xpath expr="//t[@t-set='head']" position="before">
            <t t-set="additional_title">ورود به سیستم</t>
        </xpath>
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="placeholder">ایمیل خود را وارد کنید</attribute>
        </xpath>
        <xpath expr="//input[@name='password']" position="attributes">
            <attribute name="placeholder">گذرواژه خود را وارد کنید</attribute>
        </xpath>
        <!-- Core fa_IR translation of "Wrong login/password" has a typo
             ("نام وردو"); show a correct sentence for either form, pass
             every other error through unchanged. -->
        <xpath expr="//p[hasclass('alert-danger')]/t[@t-out='error']" position="replace">
            <t t-if="error in ('Wrong login/password', 'نام وردو/گذرواژه اشتباه')">نام کاربری یا گذرواژه اشتباه است</t>
            <t t-else="" t-out="error"/>
        </xpath>
    </template>

    <template id="reset_password_title_fa" name="EOT: reset password tab title in Persian" inherit_id="auth_signup.reset_password">
        <xpath expr="//t[@t-call='web.login_layout']" position="before">
            <t t-set="additional_title">بازنشانی گذرواژه</t>
        </xpath>
    </template>

    <template id="login_oauth_fa" name="EOT: sign-in alternatives divider in Persian" inherit_id="web.login_oauth">
        <xpath expr="//div[hasclass('o_login_auth')]/em" position="replace">
            <em class="d-block my-3 small text-center text-muted">یا</em>
        </xpath>
    </template>

    <template id="login_passkey_fa" name="EOT: passkey button in Persian" inherit_id="auth_passkey.auth_passkey_login_oauth">
        <xpath expr="//t[@t-set='passkey_body']" position="replace">
            <t t-set="passkey_body">ورود با کلید عبور</t>
        </xpath>
    </template>

    <!--
        Signed-in account menu in the header (portal.user_dropdown and
        portal.my_account_link): "Logout" / "My Account" have no fa.po entry
        upstream. Elements copied from the Odoo 20 source, wording only.
        Found by a signed-in clone render (eot render, clone and portal options).
    -->
    <template id="user_dropdown_logout_fa" name="EOT: account menu logout in Persian" inherit_id="portal.user_dropdown">
        <xpath expr="//button[@id='o_logout']" position="replace">
            <button id="o_logout" type="submit" class="btn w-100 ps-3 text-start">
                <i class="oi oi-fw small text-primary-emphasis" data-icon="logout"/> خروج
            </button>
        </xpath>
    </template>
    <template id="user_dropdown_apps_fa" name="EOT: account menu backend link in Persian" inherit_id="portal.user_dropdown">
        <!-- "Apps" (internal users only) has no fa.po entry for this template. -->
        <xpath expr="//a[@id='o_backend_user_dropdown_link']" position="replace">
            <a groups="base.group_user" href="/odoo" role="menuitem" class="dropdown-item ps-3" id="o_backend_user_dropdown_link">
                <i class="oi oi-fw me-1 small text-primary-emphasis" data-icon="grid_view"/> برنامه‌ها
            </a>
        </xpath>
    </template>
    <template id="my_account_link_fa" name="EOT: account menu link in Persian" inherit_id="portal.my_account_link">
        <xpath expr="//a[@href='/my/home'][@role='menuitem']" position="replace">
            <a href="/my/home" role="menuitem" class="dropdown-item ps-3">
                <i class="oi oi-fw me-1 small text-primary-emphasis" data-icon="badge"/> حساب من
            </a>
        </xpath>
    </template>

    <template id="search_results_fa" name="EOT: search results page in Persian" inherit_id="website.list_hybrid">
        <!-- Tab title fell back to the view name "Any Search Results". -->
        <xpath expr="//t[@t-call='website.layout']" position="before">
            <t t-set="additional_title">نتایج جستجو</t>
        </xpath>
        <xpath expr="//t[@t-if='not results']" position="replace">
            <t t-if="not results">
                <div class="text-center">
                    <div class="mt-5 mb-3"><t t-call="website.empty_search_svg"/></div>
                    <t t-if="search">برای «<t t-out="search"/>» نتیجه‌ای پیدا نشد.</t>
                    <t t-else="">عبارتی برای جستجو وارد کنید.</t>
                </div>
            </t>
        </xpath>
        <xpath expr="//t[@t-elif='fuzzy_search']" position="replace">
            <t t-elif="fuzzy_search">
                <div class="alert alert-warning mt8" role="alert">
                    برای «<t t-out="search"/>» نتیجه‌ای پیدا نشد. نتایج «<t t-out="fuzzy_search"/>» نمایش داده شده است.
                </div>
            </t>
        </xpath>
        <xpath expr="//h2[hasclass('text-muted')]" position="replace">
            <h2 class="small fw-normal text-muted">
                <t t-out="{'Blog Articles': 'مطالب کتابخانه', 'Pages': 'صفحات', 'Blogs': 'بخش‌های کتابخانه'}.get(bucket['groupName'], bucket['groupName'])"/> · <t t-out="bucket['searchCount']"/> نتیجه
            </h2>
        </xpath>
        <xpath expr="//button[hasclass('o_load_more')]" position="replace">
            <button class="o_load_more btn btn-light" t-att-data-search-type="group_result[0]">نمایش بیشتر</button>
        </xpath>
    </template>

    <!--
        404: core's page is English ("Error 404", "We couldn't find the
        page you're looking for!") with a stock illustration. Replace the
        body with a Persian page in the site's style. Links are to pages
        that exist and are published (checked with `eot links`).
    -->
    <template id="page_404_fa" name="EOT: 404 page" inherit_id="http_routing.404">
        <!-- Tab title: without additional_title it falls back to this view's
             name ("Page Not Found"); found by `eot audit`. -->
        <xpath expr="//t[@t-call='web.frontend_layout']" position="before">
            <t t-set="additional_title">صفحه پیدا نشد</t>
        </xpath>
        <xpath expr="//div[@id='wrap']/div[hasclass('oe_structure')]" position="replace">
            <section class="eot-404 eot-grid-bg">
                <div class="eot-h-field" aria-hidden="true"><span class="eot-f1"/><span class="eot-f3"/></div>
                <div class="container">
                    <span class="eot-404-code" aria-hidden="true">۴۰۴</span>
                    <h1>این صفحه پیدا نشد</h1>
                    <p>نشانی‌ای که باز کرده‌اید وجود ندارد یا جابه‌جا شده است. از یکی از بخش‌های اصلی سایت ادامه دهید یا از جستجو استفاده کنید.</p>
                    <div class="eot-actions">
                        <a href="/" class="btn btn-primary">صفحه اصلی</a>
                        <a href="/website/search" class="btn btn-outline-primary">جستجو در سایت</a>
                    </div>
                    <nav class="eot-404-links" aria-label="بخش‌های اصلی">
                        <a href="/کتب">کتاب‌ها</a>
                        <a href="/مقالات">مقالات</a>
                        <a href="/فرهنگنامه">فرهنگنامه</a>
                        <a href="/خدمات">خدمات</a>
                        <a href="/about">درباره هیجان اندیشه</a>
                        <a href="/contactus">تماس با ما</a>
                    </nav>
                </div>
            </section>
        </xpath>
    </template>

    <!--
        Milestone 8: account portal strings with no fa_IR entry upstream
        (portal, auth_passkey_portal; checked in the Odoo 20 source on
        eot-odoo-prod). Elements whose text follows an icon are replaced
        whole, copied from that source with only the wording changed:
        position="replace" cannot target a bare text node (CLAUDE.md).
    -->
    <template id="portal_breadcrumbs_fa" name="EOT: portal breadcrumbs in Persian" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//li[@t-if=&quot;page_name == 'my_addresses'&quot;]" position="replace">
            <li t-if="page_name == 'my_addresses'" class="breadcrumb-item active">نشانی‌ها</li>
        </xpath>
        <xpath expr="//a[@href='/my/addresses']" position="replace">
            <a href="/my/addresses" aria-label="نشانی‌ها" title="نشانی‌ها">نشانی‌ها</a>
        </xpath>
        <xpath expr="//li[@t-if=&quot;page_name == 'my_details'&quot;]" position="replace">
            <li t-if="page_name == 'my_details'" class="breadcrumb-item active">اطلاعات حساب</li>
        </xpath>
        <xpath expr="//li[@t-if=&quot;page_name == 'address_form'&quot;]" position="replace">
            <li t-if="page_name == 'address_form'" class="breadcrumb-item active">جزئیات</li>
        </xpath>
    </template>

    <template id="portal_addresses_fa" name="EOT: addresses page in Persian" inherit_id="portal.my_addresses">
        <xpath expr="//t[@t-set='additional_title']" position="replace">
            <t t-set="additional_title">نشانی‌های من</t>
        </xpath>
        <xpath expr="//h5[contains(., 'Delivery addresses')]" position="replace">
            <h5 class="mb-0">نشانی‌های ارسال</h5>
        </xpath>
        <xpath expr="//a[hasclass('o_address_card_add_new')]" position="replace">
            <a
                role="button"
                t-att-href="new_address_url"
                t-att-data-address-type="address_type"
                class="o_address_card_add_new btn btn-outline-primary btn-sm"
                title="افزودن نشانی"
                aria-label="افزودن نشانی"
            >
                <i class="oi me-1" data-icon="add"/>افزودن
            </a>
        </xpath>
        <xpath expr="//h5[contains(., 'Billing addresses')]" position="replace">
            <h5 class="mb-0">نشانی‌های صورتحساب</h5>
        </xpath>
        <xpath expr="//a[contains(@t-attf-class, 'o_add_billing_address_btn')]" position="replace">
            <a
                role="button"
                t-att-href="new_address_url"
                t-att-data-address-type="address_type"
                t-attf-class="o_address_card_add_new o_add_billing_address_btn btn btn-outline-primary btn-sm {{'d-none' if use_delivery_as_billing else ''}}"
                title="افزودن نشانی"
                aria-label="افزودن نشانی"
            >
                <i class="oi me-1" data-icon="add"/>افزودن
            </a>
        </xpath>
    </template>

    <template id="portal_address_card_fa" name="EOT: address card in Persian" inherit_id="portal.address_card">
        <xpath expr="//span[@t-if='is_user_address']" position="replace">
            <span
                t-if="is_user_address"
                t-att-class=" badge_classes "
            >
                نشانی اصلی
            </span>
        </xpath>
    </template>

    <template id="portal_address_fields_fa" name="EOT: address form in Persian" inherit_id="portal.address_form_fields">
        <xpath expr="//label[@for='o_name']" position="replace">
            <label class="col-form-label" for="o_name">نام</label>
        </xpath>
        <xpath expr="//select[@name='country_id']/option[@value='']" position="replace">
            <option value="">کشور...</option>
        </xpath>
        <xpath expr="//select[@name='state_id']/option[@value='']" position="replace">
            <option value="">استان...</option>
        </xpath>
        <xpath expr="//select[@name='city_id']/option[@value='']" position="replace">
            <option value="">شهر...</option>
        </xpath>
        <xpath expr="//label[@for='o_company_name']" position="replace">
            <label
                class="col-form-label fw-normal label-optional"
                for="o_company_name"
            >
                شرکت
            </label>
        </xpath>
    </template>

    <template id="portal_my_details_fa" name="EOT: account details in Persian" inherit_id="portal.portal_my_details">
        <xpath expr="//t[@t-call='portal.portal_layout']" position="attributes">
            <attribute name="additional_title.translate">اطلاعات حساب</attribute>
        </xpath>
        <xpath expr="//h3[hasclass('mb-3')]" position="replace">
            <h3 class="mb-3">اطلاعات حساب</h3>
        </xpath>
    </template>

    <template id="portal_security_fa" name="EOT: security page in Persian" inherit_id="portal.portal_my_security">
        <!-- The modal also has a close (x) button with the same data attribute:
             match the text button by its exact class, not just the attribute. -->
        <xpath expr="//button[@class='btn'][@data-bs-dismiss='modal']" position="replace">
            <button type="button" class="btn" data-bs-dismiss="modal">
                انصراف
            </button>
        </xpath>
    </template>

    <template id="portal_passkeys_fa" name="EOT: passkeys section in Persian" inherit_id="auth_passkey_portal.passkeys_portal_hook">
        <xpath expr="//section[@name='portal_passkey_management']/h4" position="replace">
            <h4>
                کلیدهای عبور
            </h4>
        </xpath>
        <xpath expr="//section[@name='portal_passkey_management']//thead/tr" position="replace">
            <tr>
                <th>نام</th>
                <th>ایجاد</th>
                <th>آخرین استفاده</th>
                <th/>
                <th/>
            </tr>
        </xpath>
        <xpath expr="//button[@id='portal_passkey_add']" position="replace">
            <button type="button" class="btn btn-light mt-1" id="portal_passkey_add">
                افزودن کلید عبور
            </button>
        </xpath>
    </template>

    <template id="portal_address_footer_fa" name="EOT: address form buttons in Persian" inherit_id="portal.address_footer">
        <xpath expr="//a[hasclass('btn-outline-secondary')]" position="replace">
            <a
                role="button"
                t-att-href="discard_url or '/my/'"
                class="btn btn-outline-secondary w-100 w-md-auto order-md-1 order-3"
            >
                <i class="fw-light oi me-2" data-icon="keyboard_arrow_left"/>انصراف
            </a>
        </xpath>
        <xpath expr="//span[hasclass('px-3')]" position="replace">
            <span class="px-3">یا</span>
        </xpath>
        <xpath expr="//t[@name='save_address_label']" position="replace">
            <t name="save_address_label">ذخیره</t>
        </xpath>
    </template>

    <!-- Browser tab titles of the portal pages (additional_title) -->
    <template id="portal_my_home_title_fa" name="EOT: account home tab title in Persian" inherit_id="portal.portal_my_home">
        <xpath expr="//t[@t-call='portal.portal_layout']" position="attributes">
            <attribute name="additional_title.translate">حساب من</attribute>
        </xpath>
    </template>

    <template id="portal_address_management_title_fa" name="EOT: address form tab title in Persian" inherit_id="portal.address_management">
        <xpath expr="//t[@t-call='portal.portal_layout']" position="attributes">
            <attribute name="additional_title.translate">مدیریت نشانی</attribute>
        </xpath>
    </template>
</odoo>
