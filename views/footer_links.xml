                        </div>
                        <nav aria-label="خدمات">
                            <h2>خدمات</h2>
                            <a href="/مشاوره-روانشناسی-آنلاین">مشاوره روان‌شناسی</a>
                            <a href="/آزمون-روانشناسی">ارزیابی‌ها</a>
                            <a href="/یادگیری-خودیار-روانشناسی">یادگیری آنلاین</a>
                            <a href="/کلاس-گروهی-آنلاین">کلاس‌های گروهی</a>
                            <a href="/کارورزی-روانشناسی-آنلاین">کارورزی</a>
                            <a href="/خدمات">نقشه خدمات</a>
                        </nav>
                        <nav aria-label="دانش و اعتماد">
                            <h2>دانش و اعتماد</h2>
                            <a href="/کتب">کتاب‌ها</a>
                            <a href="/مقالات">مقالات</a>
                            <a href="/فرهنگنامه">فرهنگنامه</a>
                            <a href="/about">درباره هیجان اندیشه</a>
                            <a href="/اصول-علمی-و-تحریریه">اصول علمی و تحریریه</a>
                            <a href="/سوالات-متداول">سؤالات متداول</a>
                        </nav>
                        <nav aria-label="حقوق و ایمنی">
                            <h2>حقوق و ایمنی</h2>
                            <a href="/حریم-خصوصی">حریم خصوصی</a>
