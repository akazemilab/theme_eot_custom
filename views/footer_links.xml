<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Milestone 6: footer link columns (approved on the mockup canvas).
        Website 1's footer is the "Centered" layout (its own copy of
        website.template_footer_centered, view 1604), whose #footer is
        empty apart from the copyright bar below it. Before this, nothing on
        the site linked to the legal, trust or service pages.
        Styles: .eot-footer-cols in static/src/scss/pages.scss.
    -->
    <template id="footer_link_columns"
              name="EOT Footer: link columns"
              inherit_id="website.template_footer_centered">
        <xpath expr="//div[@id='footer']" position="inside">
            <section class="eot-footer-cols">
