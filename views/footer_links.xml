                            <a href="/سیاست-کوکی">سیاست کوکی</a>
                            <a href="/دسترس-پذیری">دسترس‌پذیری</a>
                            <a href="/ایمنی-روانشناختی">ایمنی روان‌شناختی</a>
                            <a href="/راهنمای-سایت">راهنمای سایت</a>
                        </nav>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
