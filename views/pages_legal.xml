<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Milestone 6, group 3: legal pages (one shared minimal template),
        contact page and the contact thank-you page.
        /privacy (stock stub) redirects to /حریم-خصوصی (controllers/redirects.py).
    -->

    <template id="legal_head" name="EOT: legal page header">
        <header class="eot-legal-head">
            <div class="container">
                <span class="eot-kicker" t-out="kicker"/>
                <h1 t-out="title"/>
                <p t-out="lead"/>
                <nav class="eot-legal-tabs" aria-label="سیاست‌ها">
                    <t t-foreach="[('/حریم-خصوصی', 'حریم خصوصی'), ('/شرایط-استفاده', 'شرایط استفاده'), ('/سیاست-کوکی', 'سیاست کوکی'), ('/دسترس-پذیری', 'دسترس‌پذیری')]" t-as="l">
                        <a t-att-href="l[0]" t-att-aria-current="'page' if l[0] == current else None" t-out="l[1]"/>
                    </t>
                </nav>
            </div>
        </header>
    </template>

    <!-- ================================================================ privacy -->
    <template id="page_privacy" name="EOT page: privacy" inherit_id="theme_eot_custom.eot_pv_privacy">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure eot-pg eot-pg-legal">
                <t t-call="theme_eot_custom.legal_head" current.f="/حریم-خصوصی" kicker.f="حفاظت از اطلاعات کاربران" title.f="سیاست حریم خصوصی" lead.f="توضیح روشن درباره اطلاعاتی که ممکن است هنگام استفاده از سایت و خدمات ثبت شوند و نحوه استفاده و حفاظت از آن‌ها."/>
                <article class="container eot-legal-body">
                    <section>
                        <h2 class="eot-legal-h2">چه اطلاعاتی ممکن است ثبت شود؟</h2>
                        <dl class="eot-dl-rows">
                            <div><dt>اطلاعات حساب و تماس</dt><dd>مانند نام، ایمیل، تلفن یا اطلاعاتی که در فرم‌ها وارد می‌کنید.</dd></div>
                            <div><dt>اطلاعات ارزیابی</dt><dd>پاسخ‌ها، امتیازها و نتایج ابزارهای روان‌شناختی؛ این داده‌ها می‌توانند ماهیت حساس داشته باشند.</dd></div>
                            <div><dt>اطلاعات رزرو و آموزش</dt><dd>اطلاعات لازم برای نوبت، ثبت‌نام کلاس یا پیشرفت در eLearning.</dd></div>
                            <div><dt>اطلاعات فنی</dt><dd>داده‌های ضروری نشست، امنیت، مرورگر و گزارش‌های فنی مورد نیاز برای کارکرد سایت.</dd></div>
                            <div><dt>پیام‌ها</dt><dd>محتوایی که از طریق فرم تماس یا پشتیبانی ارسال می‌کنید.</dd></div>
                        </dl>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">چرا از اطلاعات استفاده می‌شود؟</h2>
                        <p class="eot-ed-p">برای ارائه و مدیریت خدمت انتخاب‌شده، ایجاد یا نگهداری حساب، نمایش نتایج و پیشرفت، پشتیبانی، امنیت، جلوگیری از سوءاستفاده، رفع خطا و انجام الزامات قانونی یا حرفه‌ای مرتبط.</p>
                        <p class="eot-ed-p">اطلاعات حساس روان‌شناختی فقط باید در حد لازم برای خدمت مربوطه پردازش شوند و کاربران نیز بهتر است از ارسال جزئیات غیرضروری در فرم‌های عمومی خودداری کنند.</p>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">دسترسی و اشتراک اطلاعات</h2>
                        <p class="eot-ed-p">دسترسی به اطلاعات باید متناسب با نقش و ضرورت ارائه خدمت باشد. در مواردی که یک خدمت با سامانه مرتبط دیگری مانند سامانه رزرو انجام می‌شود، اطلاعات لازم برای همان فرایند ممکن است در آن سامانه ثبت شود.</p>
                        <p class="eot-ed-p">اطلاعات ممکن است فقط در حد لازم با ارائه‌دهندگان فنی، متخصص مربوط به خدمت یا در موارد الزام قانونی پردازش یا در دسترس قرار گیرد.</p>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">مدت نگهداری و درخواست‌های کاربر</h2>
                        <p class="eot-ed-p">اطلاعات تا زمانی نگهداری می‌شوند که برای ارائه خدمت، امنیت، سوابق ضروری، حل اختلاف یا الزامات قانونی/حرفه‌ای لازم باشند. مدت دقیق می‌تواند بر اساس نوع داده و خدمت متفاوت باشد.</p>
                        <p class="eot-ed-p">برای درخواست دسترسی، اصلاح یا بررسی امکان حذف اطلاعات می‌توانید از صفحه تماس با ما استفاده کنید. برخی سوابق ممکن است به دلایل قانونی، امنیتی یا حرفه‌ای قابل حذف فوری نباشند.</p>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">کوکی‌ها، افراد کم‌سن و تغییر سیاست</h2>
                        <p class="eot-ed-p">سایت برای کارکردهایی مانند نشست کاربر، احراز هویت، فرم‌ها و امنیت ممکن است از کوکی‌های ضروری استفاده کند. جزئیات بیشتر در سیاست کوکی آمده است.</p>
                        <p class="eot-ed-p">در خدمات مرتبط با کودکان و نوجوانان، مشارکت و رضایت والد یا سرپرست باید متناسب با نوع خدمت، سن و الزامات مربوط در نظر گرفته شود.</p>
                    </section>
                    <div class="eot-legal-foot eot-row-btns"><a href="/contactus" class="eot-btn eot-btn-teal">درخواست درباره اطلاعات شخصی</a><a href="/سیاست-کوکی" class="eot-btn eot-btn-line">سیاست کوکی</a></div>
                </article>
            </div>
        </xpath>
    </template>

    <!-- ================================================================ terms -->
    <template id="page_terms" name="EOT page: terms" inherit_id="theme_eot_custom.eot_pv_terms">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure eot-pg eot-pg-legal">
                <t t-call="theme_eot_custom.legal_head" current.f="/شرایط-استفاده" kicker.f="قواعد عمومی استفاده" title.f="شرایط استفاده از سایت و خدمات" lead.f="چارچوب عمومی استفاده از محتوای علمی، ارزیابی‌ها، دوره‌ها، کلاس‌ها، رزرو مشاوره و حساب کاربری."/>
                <article class="container eot-legal-body">
                    <section>
                        <h2 class="eot-legal-h2">دامنه این شرایط</h2>
                        <p class="eot-ed-p">با استفاده از سایت یا هر یک از خدمات هیجان اندیشه، این شرایط عمومی و شرایط اختصاصی همان خدمت ـ در صورتی که در صفحه ثبت‌نام، رزرو یا پرداخت نمایش داده شود ـ مبنای استفاده قرار می‌گیرد.</p>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">محتوای آموزشی و روان‌شناختی</h2>
                        <ul class="eot-ed-list">
                            <li>مقالات، کتاب‌ها، فرهنگنامه و eLearning برای آموزش و اطلاع‌رسانی هستند.</li>
                            <li>نتیجه خودسنجی به‌تنهایی تشخیص پزشکی یا روان‌شناختی نیست.</li>
                            <li>محتوای آموزشی جایگزین رابطه درمانی یا مشاوره فردی نیست.</li>
                            <li>در وضعیت اورژانسی نباید از فرم تماس یا خدمات زمان‌بندی‌شده به‌عنوان کانال فوریت استفاده شود.</li>
                        </ul>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">حساب کاربری و استفاده مجاز</h2>
                        <p class="eot-ed-p">کاربر مسئول حفظ اطلاعات ورود خود و ارائه اطلاعات درست در حد لازم برای خدمت است. استفاده برای دسترسی غیرمجاز، اختلال در سرویس، استخراج انبوه داده، نقض حقوق دیگران یا بازنشر غیرمجاز محتوا مجاز نیست.</p>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">رزرو، ثبت‌نام و پرداخت</h2>
                        <p class="eot-ed-p">هزینه، مدت، ظرفیت، تاریخ، شرایط تغییر زمان یا لغو هر خدمت می‌تواند متفاوت باشد و اطلاعات نهایی همان چیزی است که هنگام رزرو یا ثبت‌نام در صفحه مربوط نمایش داده می‌شود.</p>
                        <p class="eot-ed-p">در صورت تغییر برنامه توسط ارائه‌دهنده، اطلاع‌رسانی و گزینه‌های قابل ارائه بر اساس شرایط همان خدمت انجام می‌شود.</p>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">مالکیت فکری و لینک‌های مرتبط</h2>
                        <p class="eot-ed-p">متن‌ها، طراحی‌ها، دوره‌ها و محتوای اختصاصی سایت تحت حقوق مؤلف و سایر حقوق مربوط قرار دارند مگر آنکه خلاف آن ذکر شده باشد. استفاده شخصی و آموزشی مجاز است، اما بازنشر تجاری یا گسترده بدون مجوز مجاز نیست.</p>
                        <p class="eot-ed-p">برخی فرایندها ممکن است به سامانه‌های مرتبط مانند سیستم رزرو منتقل شوند. شرایط همان سامانه در آن مرحله نیز باید مطالعه شود.</p>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">تغییر خدمات و ارتباط</h2>
                        <p class="eot-ed-p">محتوا، ویژگی‌ها یا ساختار خدمات ممکن است برای بهبود علمی، فنی یا عملیاتی تغییر کند. تغییرات مهم شرایط عمومی در همین صفحه منعکس می‌شوند.</p>
                    </section>
                    <div class="eot-legal-foot"><a href="/contactus" class="eot-btn eot-btn-teal">پرسش درباره شرایط استفاده</a></div>
                </article>
            </div>
        </xpath>
    </template>

    <!-- ================================================================ cookie -->
    <template id="page_cookie" name="EOT page: cookie policy" inherit_id="theme_eot_custom.eot_pv_cookie">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure eot-pg eot-pg-legal">
                <t t-call="theme_eot_custom.legal_head" current.f="/سیاست-کوکی" kicker.f="شفافیت فنی" title.f="سیاست کوکی و ذخیره‌سازی مرورگر" lead.f="کوکی‌ها فایل‌های کوچکی هستند که برای اجرای برخی قابلیت‌های سایت، امنیت، نشست کاربر و در صورت فعال بودن ابزارهای تحلیلی استفاده می‌شوند."/>
                <article class="container eot-legal-body">
                    <section>
                        <h2 class="eot-legal-h2">کوکی‌های ضروری</h2>
                        <p class="eot-ed-p">برخی کوکی‌ها برای کارکرد پایه سایت ضروری‌اند؛ از جمله نگهداری نشست، ورود کاربر، امنیت، سبد یا فرایندهای فرم و جلوگیری از سوءاستفاده. غیرفعال کردن این موارد ممکن است باعث شود بخشی از سایت درست کار نکند.</p>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">کوکی‌های ترجیحی و تحلیلی</h2>
                        <p class="eot-ed-p">کوکی‌های ترجیحی می‌توانند انتخاب‌های کاربر را به خاطر بسپارند. ابزارهای تحلیلی یا اندازه‌گیری، تنها در صورتی که روی سایت فعال شوند، ممکن است داده‌های آماری درباره نحوه استفاده از سایت ثبت کنند.</p>
                        <p class="eot-ed-p">فعال یا غیرفعال بودن ابزارهای تحلیلی می‌تواند در طول زمان تغییر کند؛ تنظیمات و اطلاع‌رسانی سایت باید متناسب با ابزارهای واقعاً فعال نگهداری شود.</p>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">مدیریت کوکی‌ها</h2>
                        <p class="eot-ed-p">کاربر می‌تواند از تنظیمات مرورگر خود کوکی‌ها را مشاهده، حذف یا محدود کند. حذف کوکی‌های ضروری ممکن است باعث خروج از حساب یا از دست رفتن برخی تنظیمات موقت شود.</p>
                    </section>
                    <div class="eot-legal-foot eot-row-btns"><a href="/contactus" class="eot-btn eot-btn-teal">پرسش درباره داده‌ها</a><a href="/حریم-خصوصی" class="eot-btn eot-btn-line">حریم خصوصی</a></div>
                </article>
            </div>
        </xpath>
    </template>

    <!-- ================================================================ accessibility -->
    <template id="page_access" name="EOT page: accessibility" inherit_id="theme_eot_custom.eot_pv_access">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure eot-pg eot-pg-legal">
                <t t-call="theme_eot_custom.legal_head" current.f="/دسترس-پذیری" kicker.f="دسترسی برابر به محتوا" title.f="بیانیه دسترس‌پذیری" lead.f="هدف ما این است که محتوای علمی، آموزشی و خدمات دیجیتال هیجان اندیشه برای طیف گسترده‌تری از کاربران قابل استفاده باشد."/>
                <article class="container eot-legal-body">
                    <section>
                        <h2 class="eot-legal-h2">تعهد و هدف</h2>
                        <p class="eot-ed-p">در طراحی و توسعه صفحات جدید، هدف ما نزدیک شدن به اصول WCAG 2.2 سطح AA است: ساختار عنوان‌ها، متن خوانا، لینک‌های معنی‌دار، استفاده با صفحه‌کلید و متن جایگزین مناسب برای تصاویر معنادار.</p>
                        <p class="eot-note"><strong>وضعیت انطباق رسمی:</strong> در حال حاضر ارزیابی جامع مستقل برای اعلام انطباق کامل کل سایت انجام نشده است؛ بنابراین این صفحه ادعای گواهی یا انطباق کامل نمی‌کند.</p>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">محدودیت‌های احتمالی</h2>
                        <ul class="eot-ed-list">
                            <li>بخشی از محتوای قدیمی ممکن است از استانداردهای جدیدتر دسترس‌پذیری فاصله داشته باشد.</li>
                            <li>برخی فرم‌ها، فایل‌ها یا اجزای سامانه‌های مرتبط ممکن است تجربه متفاوتی با فناوری‌های کمکی داشته باشند.</li>
                            <li>در صورت مشاهده مانع دسترسی، گزارش کاربر برای اولویت‌بندی اصلاحات استفاده می‌شود.</li>
                        </ul>
                    </section>
                    <section>
                        <h2 class="eot-legal-h2">بازخورد دسترس‌پذیری</h2>
                        <p class="eot-ed-p">اگر در مشاهده محتوا، استفاده با صفحه‌کلید، فرم‌ها، کنتراست، متن جایگزین یا هر بخش دیگری با مانع مواجه شدید، از صفحه تماس موضوع را با عنوان «دسترس‌پذیری» برای ما ارسال کنید و در صورت امکان URL صفحه و شرح مشکل را بنویسید.</p>
                    </section>
                    <div class="eot-legal-foot"><a href="/contactus" class="eot-btn eot-btn-teal">گزارش مشکل دسترس‌پذیری</a></div>
                </article>
            </div>
        </xpath>
    </template>

    <!-- ================================================================
         /contactus - contact page (website 1's own page)
         Owner's decision: a contact form, plus info@eot.ir and 021-88174100.
         The form is Odoo 20's own s_website_form structure (copied from
         this instance's stock contact view), sending to info@eot.ir via
         mail.mail; the security signature for email_to is added at render
         time by website/models/ir_qweb.py (add_form_signature).
         ================================================================ -->
    <template id="page_contact" name="EOT page: contact" inherit_id="theme_eot_custom.eot_pv_contact">
        <!--
            The old view's header (outside #wrap) called
            request.env['website.visitor']._get_visitor_from_request(),
            which moved to ir.http in Odoo 20 (page 500'd), and fed a
            data-for prefill whose email_to was the company's personal
            address. Neither is wanted: remove all three nodes.
        -->
        <xpath expr="//t[@t-set='logged_partner']" position="replace"/>
        <!-- Keep the contactus_form_values hook (stock modules such as
             website_crm xpath onto it; removing it made /contactus 500 once
             website_crm was installed for Talent Search). Its old value used
             logged_partner, so it is reset to an empty dict instead. -->
        <xpath expr="//t[@t-set='contactus_form_values']" position="attributes">
            <attribute name="t-value">{}</attribute>
        </xpath>
        <xpath expr="//span[@data-for='contactus_form']" position="replace"/>
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure eot-pg eot-pg-svc">
                <div class="container">
                    <header class="eot-contact-head">
                        <span class="eot-kicker">ارتباط با هیجان اندیشه</span>
                        <h1>چطور می‌توانیم کمک کنیم؟</h1>
                        <p class="eot-body" style="font-size: 1.1rem; max-width: 56rem;">اگر موضوع شما به یکی از خدمات مشخص مربوط است، از مسیر مستقیم همان خدمت استفاده کنید؛ برای سایر موضوعات، پیام خود را از فرم تماس برای ما بفرستید.</p>
                    </header>
                    <section>
                        <div class="eot-sec-head" style="flex-direction: row; align-items: baseline; gap: 1rem; flex-wrap: wrap;"><h2 class="eot-h3">مسیر سریع‌تر</h2><span class="eot-lead">با انتخاب موضوع، مستقیماً وارد صفحه مرتبط شوید.</span></div>
                        <div class="eot-grid eot-grid-3" style="gap: .75rem;">
                            <a href="/مشاوره-روانشناسی-آنلاین" class="eot-card eot-route"><strong>مشاوره روان‌شناسی</strong><span>انتخاب روان‌شناس یا مشاور و مشاهده زمان‌های قابل رزرو.</span><em>مشاهده مشاوران ←</em></a>
                            <a href="/آزمون-روانشناسی" class="eot-card eot-route"><strong>ارزیابی‌های روان‌شناختی</strong><span>آزمون‌ها و ارزیابی‌های آنلاین برای خودشناسی، استعداد و موضوعات روان‌شناختی.</span><em>مشاهده ارزیابی‌ها ←</em></a>
                            <a href="/یادگیری-خودیار-روانشناسی" class="eot-card eot-route"><strong>دوره‌های eLearning</strong><span>مسیرهای یادگیری مبتنی بر ارزیابی، کتاب، مقاله، فرهنگنامه و کارورزی.</span><em>ورود به مرکز یادگیری ←</em></a>
                            <a href="/کلاس-گروهی-آنلاین" class="eot-card eot-route"><strong>کلاس‌ها و کارگاه‌ها</strong><span>جلسات گروهی، برنامه‌های هفتگی و دوره‌های چندجلسه‌ای.</span><em>برنامه کلاس‌ها ←</em></a>
