    </template>

    <!-- ================================================================ site guide -->
    <template id="page_siteguide" name="EOT page: site guide" inherit_id="theme_eot_custom.eot_pv_siteguide">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure eot-pg eot-pg-ed">
                <div class="container">
                    <header class="eot-ed-head eot-stack">
                        <nav class="eot-crumbs" aria-label="مسیر"><a href="/">خانه</a><span>/</span><span>راهنمای سایت</span></nav>
                        <span class="eot-kicker">راهنمای کامل وب‌سایت</span>
                        <h1>راهنمای سایت</h1>
