    <!-- ================================================================ editorial principles -->
    <template id="page_editorial" name="EOT page: editorial principles" inherit_id="theme_eot_custom.eot_pv_editorial">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure eot-pg eot-pg-ed">
                <div class="container">
                    <header class="eot-ed-head eot-stack">
                        <t t-call="theme_eot_custom.trust_crumbs"/>
                        <span class="eot-kicker">شفافیت علمی و تحریریه</span>
                        <h1>اصول علمی، انتشار و اصلاح محتوا</h1>
                        <p class="eot-ed-lead">چارچوبی برای مشخص بودن نویسنده، منبع، بازبینی، به‌روزرسانی و مسئولیت علمی محتوای هیجان اندیشه.</p>
                    </header>
                    <div class="eot-ed-grid">
                        <article class="eot-ed-article">
                            <section id="s1">
                                <h2 class="eot-ed-h2"><small>۰۱</small>هدف انتشار</h2>
                                <p class="eot-ed-p">محتوای هیجان اندیشه باید پیش از هر چیز برای کمک به فهم بهتر موضوعات روان‌شناسی، آموزش و رشد انسانی تولید شود؛ نه صرفاً برای جذب بازدید از موتورهای جست‌وجو.</p>
                                <p class="eot-ed-p">عنوان، خلاصه و متن باید ماهیت واقعی محتوا را توصیف کنند و از ادعاهای قطعی، اغراق‌آمیز یا ترس‌آفرین پرهیز شود.</p>
                            </section>
                            <section id="s2">
                                <h2 class="eot-ed-h2"><small>۰۲</small>نویسندگی، تخصص و بازبینی</h2>
                                <ul class="eot-ed-list">
                                    <li>در محتوایی که نویسنده یا بازبین مشخص دارد، نام او باید به‌صورت روشن نمایش داده شود و در صورت امکان به صفحه پروفایل او پیوند داده شود.</li>
                                    <li>محتوای حساس مرتبط با سلامت روان باید متناسب با ماهیت موضوع، توسط فرد دارای دانش یا صلاحیت حرفه‌ای مناسب بازبینی شود.</li>
                                    <li>نقش نویسنده، بازبین علمی و ناشر نباید با یکدیگر مخلوط شود.</li>
                                </ul>
                            </section>
                            <section id="s3">
                                <h2 class="eot-ed-h2"><small>۰۳</small>منابع و شواهد</h2>
                                <p class="eot-ed-p">در مطالب علمی، اولویت با منابع اولیه، مقالات پژوهشی، کتاب‌های تخصصی و منابع معتبر دانشگاهی یا حرفه‌ای است. اگر مطلبی بر نظریه یا چارچوب اختصاصی هیجان اندیشه استوار باشد، این موضوع باید برای خواننده قابل تشخیص باشد.</p>
                                <p class="eot-ed-callout">استناد به یک منبع به‌معنای تأیید همه دیدگاه‌های آن منبع نیست؛ استناد باید فقط از ادعایی که واقعاً پشتیبانی می‌کند استفاده شود.</p>
                            </section>
                            <section id="s4">
                                <h2 class="eot-ed-h2"><small>۰۴</small>تاریخ، بازبینی و اصلاح</h2>
                                <ul class="eot-ed-list">
                                    <li>تاریخ انتشار و در صورت تغییر معنادار، تاریخ آخرین به‌روزرسانی باید تا حد ممکن قابل مشاهده باشد.</li>
                                    <li>اصلاح اشتباه علمی یا factual باید بدون پنهان کردن ماهیت اصلاح انجام شود.</li>
                                    <li>تغییر تاریخ بدون تغییر واقعی محتوا صرفاً برای تازه نشان دادن صفحه انجام نمی‌شود.</li>
                                    <li>بازخورد درباره خطاهای احتمالی از طریق صفحه تماس قابل ارسال است.</li>
                                </ul>
                            </section>
                            <section id="s5">
                                <h2 class="eot-ed-h2"><small>۰۵</small>ابزارهای خودکار و هوش مصنوعی</h2>
                                <p class="eot-ed-p">اگر ابزارهای خودکار یا هوش مصنوعی در تهیه، ساختاردهی یا بازنویسی یک محتوا نقش معناداری داشته باشند، مسئولیت نهایی صحت، ایمنی و تناسب محتوا با انسانِ نویسنده یا بازبین است. محتوای سلامت روان نباید صرفاً به خروجی خودکار بدون بازبینی انسانی متکی باشد.</p>
                            </section>
                            <section id="s6">
                                <h2 class="eot-ed-h2"><small>۰۶</small>استقلال و تضاد منافع</h2>
                                <p class="eot-ed-p">محتوای آموزشی و علمی نباید به‌گونه‌ای نوشته شود که مرز میان آموزش و تبلیغ پنهان شود. اگر یک صفحه برای معرفی یا فروش خدمت طراحی شده است، ماهیت تجاری آن باید از محتوای علمی قابل تشخیص باشد.</p>
                            </section>
                            <div><a href="/contactus" class="eot-btn eot-btn-teal">گزارش خطا یا درخواست اصلاح</a></div>
                        </article>
                        <aside>
                            <nav class="eot-toc eot-page-toc" aria-label="در این صفحه">
                                <h2>در این صفحه</h2>
                                <a href="#s1">۱. هدف انتشار</a><a href="#s2">۲. نویسندگی، تخصص و بازبینی</a><a href="#s3">۳. منابع و شواهد</a><a href="#s4">۴. تاریخ، بازبینی و اصلاح</a><a href="#s5">۵. ابزارهای خودکار و هوش مصنوعی</a><a href="#s6">۶. استقلال و تضاد منافع</a>
                            </nav>
                            <t t-call="theme_eot_custom.trust_related" current.f="/اصول-علمی-و-تحریریه"/>
                        </aside>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ================================================================ psychological safety -->
    <template id="page_safety" name="EOT page: psychological safety" inherit_id="theme_eot_custom.eot_pv_safety">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure eot-pg eot-pg-ed">
                <div class="container">
                    <header class="eot-ed-head eot-stack">
                        <t t-call="theme_eot_custom.trust_crumbs"/>
                        <span class="eot-kicker">استفاده مسئولانه از خدمات</span>
                        <h1>راهنمای ایمنی روان‌شناختی</h1>
                        <p class="eot-ed-lead">مرز میان آموزش، خودسنجی و خدمات حرفه‌ای را روشن نگه دارید و در شرایط فوری از مسیر مناسب کمک بگیرید.</p>
                    </header>
                    <div class="eot-ed-grid">
                        <article class="eot-ed-article">
                            <section id="urgent" class="eot-alert-dark" role="note">
                                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#FFE38A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l9 16H3z"/><path d="M12 10v4M12 17h.01"/></svg>
                                <div class="eot-stack">
                                    <h2>شرایط فوری و بحرانی</h2>
                                    <p>اگر خطر فوری برای خودتان یا فرد دیگری وجود دارد، منتظر پاسخ فرم تماس یا نوبت برنامه‌ریزی‌شده نمانید. از خدمات اضطراری محل خود، نزدیک‌ترین مرکز درمانی یا یک فرد قابل اعتماد که می‌تواند کنار شما باشد کمک بگیرید.</p>
                                    <p class="eot-alert-sub">فرم تماس عمومی، کلاس آموزشی، خودسنجی و رزرو عادی برای مدیریت وضعیت اورژانسی طراحی نشده‌اند.</p>
                                </div>
                            </section>
                            <section id="s1">
                                <h2 class="eot-ed-h2"><small>۰۱</small>خودسنجی با تشخیص متفاوت است</h2>
                                <p class="eot-ed-p">آزمون یا فهرست آنلاین می‌تواند برای شناخت الگوها و ایجاد پرسش‌های بهتر مفید باشد، اما یک نتیجه منفرد به‌تنهایی تشخیص اختلال، پیش‌بینی آینده یا ارزش‌گذاری درباره فرد نیست.</p>
                                <p class="eot-ed-p">اگر نتیجه برای شما نگران‌کننده است، با تجربه روزمره شما تعارض دارد یا با اختلال قابل توجه در کارکرد همراه است، بررسی حرفه‌ای مناسب‌تر است.</p>
                            </section>
                            <section id="s2">
                                <h2 class="eot-ed-h2"><small>۰۲</small>آموزش با درمان متفاوت است</h2>
                                <p class="eot-ed-p">مقالات، کتاب‌ها، فرهنگنامه، eLearning و کلاس‌های آموزشی برای افزایش دانش، خودآگاهی و مهارت طراحی می‌شوند. این محتواها به‌تنهایی رابطه درمانی ایجاد نمی‌کنند و جایگزین درمان یا پیگیری بالینی نیستند.</p>
                            </section>
                            <section id="s3">
                                <h2 class="eot-ed-h2"><small>۰۳</small>چه زمانی کمک حرفه‌ای بگیرم؟</h2>
                                <ul class="eot-when eot-grid eot-grid-2" style="gap: .6rem;">
                                    <li>وقتی ناراحتی روانی پایدار یا رو به تشدید است.</li>
                                    <li>وقتی خواب، کار، تحصیل، رابطه یا فعالیت روزمره به شکل معنادار مختل شده است.</li>
                                    <li>وقتی خودسنجی یا خودآموزی باعث سردرگمی بیشتر شده است.</li>
                                    <li>وقتی نیاز به تشخیص، درمان یا تصمیم حرفه‌ای وجود دارد.</li>
                                </ul>
                                <div><a href="/مشاوره-روانشناسی-آنلاین" class="eot-btn eot-btn-teal">مشاهده خدمات مشاوره</a></div>
                            </section>
                        </article>
                        <aside>
                            <nav class="eot-toc eot-page-toc" aria-label="در این صفحه">
                                <h2>در این صفحه</h2>
                                <a href="#urgent">شرایط فوری و بحرانی</a><a href="#s1">۱. خودسنجی با تشخیص متفاوت است</a><a href="#s2">۲. آموزش با درمان متفاوت است</a><a href="#s3">۳. چه زمانی کمک حرفه‌ای بگیرم؟</a>
                            </nav>
                            <t t-call="theme_eot_custom.trust_related" current.f="/ایمنی-روانشناختی"/>
                        </aside>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ================================================================ assessment method -->
    <template id="page_method" name="EOT page: assessment method" inherit_id="theme_eot_custom.eot_pv_method">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure eot-pg eot-pg-ed">
                <div class="container">
                    <header class="eot-ed-head eot-stack">
                        <t t-call="theme_eot_custom.trust_crumbs"/>
                        <span class="eot-kicker">شفافیت در خودسنجی</span>
                        <h1>روش ارزیابی و تفسیر نتایج</h1>
                        <p class="eot-ed-lead">ارزیابی آنلاین زمانی مفیدتر است که بدانیم سؤال‌ها، عامل‌ها، امتیازها و سطح‌های تفسیر چگونه باید خوانده شوند و چه محدودیت‌هایی دارند.</p>
                    </header>
                    <div class="eot-ed-grid">
                        <article class="eot-ed-article">
                            <section id="s1">
                                <h2 class="eot-ed-h2"><small>۰۱</small>ساختار ارزیابی‌ها</h2>
                                <p class="eot-ed-p">هر ارزیابی از مجموعه‌ای از گویه‌ها تشکیل می‌شود. گویه‌ها می‌توانند به یک یا چند عامل یا محور مرتبط باشند و پاسخ‌ها بر اساس قواعد امتیازدهی همان ابزار به امتیاز عامل تبدیل شوند.</p>
                                <figure class="eot-diagram" aria-label="از گویه تا سطح تفسیر">
                                    <span class="eot-stack" style="gap: .35rem; align-items: center;"><span class="eot-dg-dots" aria-hidden="true"><i/><i/><i/><i/><i/><i/></span><strong style="font-size: .85rem;">گویه‌ها</strong></span>
                                    <svg class="eot-dg-arrow" width="40" height="16" viewBox="0 0 40 16" fill="none" stroke="#005C65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M38 8H3M9 2L3 8l6 6"/></svg>
                                    <span class="eot-dg-box" style="background: #E6F2F3; color: #004C54;">عامل / محور</span>
                                    <svg class="eot-dg-arrow" width="40" height="16" viewBox="0 0 40 16" fill="none" stroke="#005C65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M38 8H3M9 2L3 8l6 6"/></svg>
                                    <span class="eot-dg-box" style="background: #005C65; color: #fff;">امتیاز عامل</span>
                                    <svg class="eot-dg-arrow" width="40" height="16" viewBox="0 0 40 16" fill="none" stroke="#005C65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M38 8H3M9 2L3 8l6 6"/></svg>
                                    <span class="eot-dg-scale"><span class="eot-dg-bar" aria-hidden="true"><i/><i/><i/></span><span class="eot-dg-labels"><span>پایین</span><span>میانه</span><span>بالا</span></span><strong style="font-size: .85rem; text-align: center;">سطح تفسیر همان ابزار</strong></span>
                                </figure>
                                <p class="eot-ed-p">در برخی ابزارها برای عامل‌ها سطح‌هایی مانند پایین، میانه یا بالا تعریف می‌شود. این سطح‌ها طبقه‌های امتیاز همان ابزار هستند و نباید به‌طور خودکار با «بد»، «متوسط» یا «خوب» یکی گرفته شوند.</p>
                            </section>
                            <section id="s2">
                                <h2 class="eot-ed-h2"><small>۰۲</small>تفسیر نتیجه</h2>
                                <ul class="eot-ed-list">
                                    <li>نتیجه باید در چارچوب تعریف همان عامل خوانده شود.</li>
                                    <li>یک امتیاز منفرد بدون توجه به شرایط زندگی، سابقه و سایر اطلاعات تصویر کاملی از فرد نمی‌دهد.</li>
                                    <li>خودسنجی برای شناخت و یادگیری مفید است، اما تشخیص بالینی نیازمند ارزیابی حرفه‌ای است.</li>
                                    <li>اگر نتیجه با تجربه شما سازگار نیست یا نگرانی ایجاد می‌کند، بررسی آن با متخصص می‌تواند مفید باشد.</li>
                                </ul>
                            </section>
                            <section id="s3">
                                <h2 class="eot-ed-h2"><small>۰۳</small>از نتیجه تا یادگیری</h2>
                                <p class="eot-ed-p">در اکوسیستم هیجان اندیشه، نتیجه ارزیابی می‌تواند نقش «نقشه یادگیری» داشته باشد. عامل یا موضوعی که برای شما مهم‌تر است می‌تواند به یک مسیر eLearning، مقاله، مفهوم فرهنگنامه یا تمرین مرتبط وصل شود.</p>
                                <div class="eot-row-btns"><a href="/آزمون-روانشناسی" class="eot-btn eot-btn-teal">مشاهده ارزیابی‌ها</a><a href="/یادگیری-خودیار-روانشناسی" class="eot-btn eot-btn-line">مرکز یادگیری</a></div>
                            </section>
                            <section id="s4">
                                <h2 class="eot-ed-h2"><small>۰۴</small>تکرار ارزیابی و مقایسه</h2>
                                <p class="eot-ed-p">تکرار ارزیابی تنها زمانی مفید است که فاصله زمانی، شرایط و هدف مقایسه معنادار باشند. هدف از بازسنجی «گرفتن نمره بهتر» نیست؛ بلکه مشاهده تغییر احتمالی در یک الگو و ترکیب آن با تجربه واقعی زندگی است.</p>
                                <a href="/ایمنی-روانشناختی" class="eot-link">راهنمای ایمنی و مرز خودسنجی با تشخیص ←</a>
                            </section>
                        </article>
                        <aside>
                            <nav class="eot-toc eot-page-toc" aria-label="در این صفحه">
                                <h2>در این صفحه</h2>
                                <a href="#s1">۱. ساختار ارزیابی‌ها</a><a href="#s2">۲. تفسیر نتیجه</a><a href="#s3">۳. از نتیجه تا یادگیری</a><a href="#s4">۴. تکرار ارزیابی و مقایسه</a>
                            </nav>
                            <t t-call="theme_eot_custom.trust_related" current.f="/روش-ارزیابی-و-تفسیر"/>
                        </aside>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ================================================================ FAQ -->
    <template id="page_faq" name="EOT page: FAQ" inherit_id="theme_eot_custom.eot_pv_faq">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure eot-pg eot-pg-ed">
                <t t-set="faqs" t-value="[
                    ('هیجان اندیشه چیست؟', 'هیجان اندیشه یک مجموعه علمی و تخصصی در حوزه روان‌شناسی، آموزش و پرورش نخبگی است که خدمات مشاوره، ارزیابی، آموزش، پژوهش و منابع علمی را در یک اکوسیستم یکپارچه ارائه می‌کند.'),
